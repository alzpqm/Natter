#!/bin/sh

. /lib/functions.sh

# Keep following WAN changes while a manually started runtime is active, but do
# not let an interface event revive a service that is both disabled and stopped.
if ! /etc/init.d/natter enabled >/dev/null 2>&1 && \
	! /etc/init.d/natter running >/dev/null 2>&1; then
	exit 0
fi

RUNTIME_DIR=/var/run/natter
REQUESTED_INTERFACE="$1"
LOCK_DIR="$RUNTIME_DIR/.interface-trigger.lock"
STAGING_DIR=''
SETTLE_ATTEMPTS=15
LOCK_WAIT_ATTEMPTS=90
INTERFACES=''
INVALID_LOCK_SEEN=0

mkdir -p "$RUNTIME_DIR"
try_acquire_lock() {
	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
		case "$lock_pid" in
		''|*[!0-9]*)
			# A new owner writes its PID immediately after mkdir.  Give that
			# window one retry before treating an empty/corrupt lock as stale.
			INVALID_LOCK_SEEN=$((INVALID_LOCK_SEEN + 1))
			[ "$INVALID_LOCK_SEEN" -ge 2 ] || return 1
			;;
		*)
			INVALID_LOCK_SEEN=0
			kill -0 "$lock_pid" 2>/dev/null && return 1
			;;
		esac
		rm -f "$LOCK_DIR/pid" 2>/dev/null || return 1
		rmdir "$LOCK_DIR" 2>/dev/null || return 1
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
	fi
	INVALID_LOCK_SEEN=0
	if ! printf '%s\n' "$$" > "$LOCK_DIR/pid"; then
		rm -f "$LOCK_DIR/pid" 2>/dev/null
		rmdir "$LOCK_DIR" 2>/dev/null
		return 1
	fi
}

lock_attempt=1
while ! try_acquire_lock; do
	[ "$lock_attempt" -ge "$LOCK_WAIT_ATTEMPTS" ] && exit 0
	lock_attempt=$((lock_attempt + 1))
	sleep 1
done

cleanup() {
	[ -z "$STAGING_DIR" ] || rm -rf "$STAGING_DIR" 2>/dev/null
	rm -f "$LOCK_DIR/pid" 2>/dev/null
	rmdir "$LOCK_DIR" 2>/dev/null
}
trap cleanup 0 1 2 15

add_interface() {
	local interface="$1"

	[ -n "$interface" ] || return 0
	case " $INTERFACES " in
	*" $interface "*) ;;
	*) INTERFACES="${INTERFACES:+$INTERFACES }$interface" ;;
	esac
}

collect_interface() {
	local section="$1"
	local enabled interface

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get interface "$section" interface
	add_interface "$interface"
}

# A single PPPoE outage can emit events for every configured WAN at nearly the
# same time.  Serialize all trigger workers globally and snapshot every enabled
# Natter interface in one batch.  Followers wait for the leader, then observe
# the published snapshots and avoid a second procd/fw4 reload.
add_interface "$REQUESTED_INTERFACE"
config_load natter
config_foreach collect_interface instance

valid_ipv4() {
	awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++)
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255)
					exit 1
		}
	' <<-EOF >/dev/null 2>&1
	$1
	EOF
}

read_snapshot() {
	INTERFACE="$1"
	status=''
	up=''
	l3_device=''
	ipv4=''
	snapshot='unavailable|'
	snapshot_ready=0

	[ -n "$INTERFACE" ] || return 0
	status="$(ubus call "network.interface.$INTERFACE" status 2>/dev/null)" || status=''
	[ -n "$status" ] || return 0

	up="$(printf '%s' "$status" | jsonfilter -q -e '@.up' 2>/dev/null)"
	l3_device="$(printf '%s' "$status" | jsonfilter -q -e '@.l3_device' 2>/dev/null)"
	ipv4="$(printf '%s' "$status" | jsonfilter -q -e '@["ipv4-address"][0].address' 2>/dev/null)"
	if [ "$up" = true ] && [ -n "$l3_device" ] && valid_ipv4 "$ipv4"; then
		snapshot="up|${l3_device}|${ipv4}"
		snapshot_ready=1
	elif [ "$up" = false ]; then
		snapshot="down|${l3_device}"
	else
		snapshot="unavailable|${l3_device}"
	fi
}

STAGING_DIR="$(mktemp -d "$RUNTIME_DIR/.interface-trigger-stage.XXXXXX")" || exit 1
RELOAD_NEEDED=0

for INTERFACE in $INTERFACES; do
	SAFE_INTERFACE="$(printf '%s' "$INTERFACE" | tr -c 'A-Za-z0-9_.-' '_')"
	[ -n "$SAFE_INTERFACE" ] || SAFE_INTERFACE=all
	SNAPSHOT="$RUNTIME_DIR/.interface-${SAFE_INTERFACE}.snapshot"

	# netifd may emit an event before a PPPoE address is visible.  Keep sampling
	# under the global lock so the batch reload sees every completed transition.
	attempt=1
	while :; do
		read_snapshot "$INTERFACE"
		[ "$snapshot_ready" -eq 1 ] && break
		[ "$attempt" -ge "$SETTLE_ATTEMPTS" ] && break
		attempt=$((attempt + 1))
		sleep 1
	done

	if [ -f "$SNAPSHOT" ] && [ "$(cat "$SNAPSHOT" 2>/dev/null)" = "$snapshot" ]; then
		continue
	fi
	printf '%s\n' "$snapshot" > "$STAGING_DIR/${SAFE_INTERFACE}.snapshot" || exit 1
	RELOAD_NEEDED=1
done

[ "$RELOAD_NEEDED" -eq 1 ] || exit 0
/etc/init.d/natter reload || exit 1

for STAGED_SNAPSHOT in "$STAGING_DIR"/*.snapshot; do
	[ -f "$STAGED_SNAPSHOT" ] || continue
	SAFE_INTERFACE="${STAGED_SNAPSHOT##*/}"
	SAFE_INTERFACE="${SAFE_INTERFACE%.snapshot}"
	mv -f "$STAGED_SNAPSHOT" "$RUNTIME_DIR/.interface-${SAFE_INTERFACE}.snapshot" || exit 1
done
