#!/bin/sh

# Keep following WAN changes while a manually started runtime is active, but do
# not let an interface event revive a service that is both disabled and stopped.
if ! /etc/init.d/natter enabled >/dev/null 2>&1 && \
	! /etc/init.d/natter running >/dev/null 2>&1; then
	exit 0
fi

RUNTIME_DIR=/var/run/natter
INTERFACE="$1"
SAFE_INTERFACE="$(printf '%s' "$INTERFACE" | tr -c 'A-Za-z0-9_.-' '_')"
[ -n "$SAFE_INTERFACE" ] || SAFE_INTERFACE=all
LOCK_DIR="$RUNTIME_DIR/.interface-trigger-${SAFE_INTERFACE}.lock"
SNAPSHOT="$RUNTIME_DIR/.interface-${SAFE_INTERFACE}.snapshot"
TMP_SNAPSHOT=''

mkdir -p "$RUNTIME_DIR"
acquire_lock() {
	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
		case "$lock_pid" in
			''|*[!0-9]*) ;;
			*) kill -0 "$lock_pid" 2>/dev/null && return 1 ;;
		esac
		rm -f "$LOCK_DIR/pid" 2>/dev/null || return 1
		rmdir "$LOCK_DIR" 2>/dev/null || return 1
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
	fi
	if ! printf '%s\n' "$$" > "$LOCK_DIR/pid"; then
		rm -f "$LOCK_DIR/pid" 2>/dev/null
		rmdir "$LOCK_DIR" 2>/dev/null
		return 1
	fi
}
acquire_lock || exit 0
cleanup() {
	[ -z "$TMP_SNAPSHOT" ] || rm -f "$TMP_SNAPSHOT" 2>/dev/null
	rm -f "$LOCK_DIR/pid" 2>/dev/null
	rmdir "$LOCK_DIR" 2>/dev/null
}
trap cleanup 0 1 2 15

# procd can coalesce several netifd events poorly, so let the interface settle
# before taking one snapshot and one reload decision.
sleep 1

snapshot='unavailable|'
if [ -n "$INTERFACE" ]; then
	status="$(ubus call "network.interface.$INTERFACE" status 2>/dev/null)" || status=''
	if [ -n "$status" ]; then
		l3_device="$(printf '%s' "$status" | jsonfilter -q -e '@.l3_device' 2>/dev/null)"
		ipv4="$(printf '%s' "$status" | jsonfilter -q -e '@.ipv4-address[0].address' 2>/dev/null)"
		snapshot="${l3_device}|${ipv4}"
	fi
fi

if [ -f "$SNAPSHOT" ] && [ "$(cat "$SNAPSHOT" 2>/dev/null)" = "$snapshot" ]; then
	exit 0
fi

/etc/init.d/natter reload || exit 1
TMP_SNAPSHOT="$(mktemp "$RUNTIME_DIR/.interface-${SAFE_INTERFACE}.XXXXXX")" || exit 1
printf '%s\n' "$snapshot" > "$TMP_SNAPSHOT" || exit 1
mv -f "$TMP_SNAPSHOT" "$SNAPSHOT" || exit 1
TMP_SNAPSHOT=''
