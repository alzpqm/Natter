#!/usr/bin/python3

"""Probe each distinct configured WAN, preferring mwan3 interfaces when available."""

import json
import errno
import glob
import os
import re
import socket
import struct
import subprocess
import sys
import time


DEFAULT_DNS = "119.29.29.29"
DEFAULT_MARK = "0x3F00"
PROXY_BYPASS_GID = 65534
RESERVED_PORTS_PATH = os.environ.get(
    "NATTER_RESERVED_PORTS_PATH", "/proc/sys/net/ipv4/ip_local_reserved_ports"
)
RESERVED_PORTS_STATE = os.environ.get(
    "NATTER_RESERVED_PORTS_STATE", "/var/run/natter/reserved-ports"
)
STUN_SERVERS = (
    ("stun.miwifi.com", 3478),
    ("stun.chat.bilibili.com", 3478),
    ("stun.hitv.com", 3478),
    ("stun.douyucdn.cn", 18000),
)
STATE_PUBLISH_TIMEOUT = 90
IPV4_RE = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$")


def apply_proxy_bypass_group():
    """Use the router-local DIRECT socket group when the caller is privileged."""
    if not hasattr(os, "setgid") or os.getgid() == PROXY_BYPASS_GID:
        return
    try:
        # OpenClash's router-output rules exempt skgid 65534. UID remains
        # unchanged, so SO_MARK and SO_BINDTODEVICE keep working as root.
        os.setgid(PROXY_BYPASS_GID)
    except OSError:
        # Non-root/manual callers still get a useful probe; the procd Natter
        # instances apply the same group independently in the init script.
        pass


def run(command, timeout=5):
    return subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=timeout,
        check=False,
        env={key: value for key, value in os.environ.items() if key != "LD_PRELOAD"},
    )


def uci_get(key, default):
    try:
        result = run(["uci", "-q", "get", key], timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return default
    value = result.stdout.strip()
    return value if result.returncode == 0 and value else default


def valid_ipv4(value):
    if not IPV4_RE.match(value or ""):
        return False
    try:
        return all(0 <= int(part) <= 255 for part in value.split("."))
    except ValueError:
        return False


def parse_port_set(value):
    ports = set()
    for item in (value or "").strip().split(","):
        item = item.strip()
        if not item:
            continue
        parts = item.split("-", 1)
        try:
            first = int(parts[0], 10)
            last = int(parts[1], 10) if len(parts) == 2 else first
        except ValueError:
            raise ValueError("invalid reserved port range: %s" % item) from None
        if not 1 <= first <= last <= 65535:
            raise ValueError("invalid reserved port range: %s" % item)
        ports.update(range(first, last + 1))
    return ports


def format_port_set(ports):
    values = sorted(set(ports))
    ranges = []
    start = previous = None
    for port in values:
        if start is None:
            start = previous = port
        elif port == previous + 1:
            previous = port
        else:
            ranges.append(str(start) if start == previous else "%s-%s" % (start, previous))
            start = previous = port
    if start is not None:
        ranges.append(str(start) if start == previous else "%s-%s" % (start, previous))
    return ",".join(ranges)


def set_wan_socket_options(sock, device, mark, reuse=False):
    if mark:
        sock.setsockopt(
            socket.SOL_SOCKET,
            getattr(socket, "SO_MARK", 36),
            mark,
        )
    if reuse:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if hasattr(socket, "SO_REUSEPORT"):
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    sock.setsockopt(
        socket.SOL_SOCKET,
        getattr(socket, "SO_BINDTODEVICE", 25),
        device.encode("ascii") + b"\0",
    )


def encode_dns_name(hostname):
    labels = hostname.rstrip(".").split(".")
    if not labels or any(not label or len(label.encode("ascii")) > 63 for label in labels):
        raise ValueError("invalid DNS name")
    return b"".join(bytes((len(label.encode("ascii")),)) + label.encode("ascii")
                    for label in labels) + b"\0"


def skip_dns_name(packet, offset):
    while offset < len(packet):
        length = packet[offset]
        if length & 0xC0 == 0xC0:
            if offset + 2 > len(packet):
                raise ValueError("truncated DNS pointer")
            return offset + 2
        offset += 1
        if length == 0:
            return offset
        offset += length
    raise ValueError("truncated DNS name")


def parse_dns_a_records(packet, transaction_id):
    if len(packet) < 12:
        raise ValueError("short DNS response")
    response_id, flags, questions, answers, _, _ = struct.unpack("!HHHHHH", packet[:12])
    if response_id != transaction_id or flags & 0x8000 == 0 or flags & 0x000F:
        raise ValueError("DNS query failed")

    offset = 12
    for _ in range(questions):
        offset = skip_dns_name(packet, offset)
        if offset + 4 > len(packet):
            raise ValueError("truncated DNS question")
        offset += 4

    addresses = []
    for _ in range(answers):
        offset = skip_dns_name(packet, offset)
        if offset + 10 > len(packet):
            raise ValueError("truncated DNS answer")
        record_type, record_class, _, length = struct.unpack(
            "!HHIH", packet[offset:offset + 10]
        )
        offset += 10
        value = packet[offset:offset + length]
        if len(value) != length:
            raise ValueError("truncated DNS value")
        if record_type == 1 and record_class == 1 and length == 4:
            address = socket.inet_ntoa(value)
            if address not in addresses:
                addresses.append(address)
        offset += length
    return addresses


def resolve_host_on_device(device, hostname, dns_server, mark):
    if not valid_ipv4(dns_server):
        raise ValueError("invalid DNS server")
    last_error = None
    for _ in range(2):
        transaction_id = struct.unpack("!H", os.urandom(2))[0]
        request = struct.pack("!HHHHHH", transaction_id, 0x0100, 1, 0, 0, 0)
        request += encode_dns_name(hostname) + struct.pack("!HH", 1, 1)

        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            sock.settimeout(3)
            set_wan_socket_options(sock, device, mark)
            sock.connect((dns_server, 53))
            sock.send(request)
            addresses = parse_dns_a_records(sock.recv(4096), transaction_id)
            if addresses:
                return addresses
            last_error = ValueError("DNS response has no IPv4 address")
        except (OSError, ValueError, socket.timeout) as error:
            last_error = error
        finally:
            sock.close()
    raise last_error or ValueError("DNS query failed")


def listener_owner(protocol, port):
    try:
        result = run(["netstat", "-lntup"], timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return "another local service"

    wanted = "%s" % port
    for line in result.stdout.splitlines():
        fields = line.split()
        if len(fields) < 4 or not fields[0].startswith(protocol):
            continue
        local_address = fields[3]
        if local_address.rsplit(":", 1)[-1] != wanted:
            continue
        return fields[-1] if "/" in fields[-1] else "another local service"
    return "another local service"


def check_port_available(device, protocol, port, mark):
    if protocol not in ("tcp", "udp"):
        raise ValueError("protocol must be tcp or udp")
    if not 1 <= port <= 65535:
        raise ValueError("port must be from 1 to 65535")
    socket_type = socket.SOCK_STREAM if protocol == "tcp" else socket.SOCK_DGRAM
    sock = socket.socket(socket.AF_INET, socket_type)
    try:
        set_wan_socket_options(sock, device, mark, reuse=True)
        sock.bind(("0.0.0.0", port))
    except OSError as error:
        if error.errno == errno.EADDRINUSE:
            owner = listener_owner(protocol, port)
            raise OSError(
                errno.EADDRINUSE,
                "%s port %s is already used by %s" %
                (protocol.upper(), port, owner),
            )
        raise
    finally:
        sock.close()


def parse_uci_show(config):
    try:
        result = run(["uci", "-q", "show", config], timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return {}

    sections = {}
    prefix = config + "."
    for line in result.stdout.splitlines():
        if not line.startswith(prefix) or "=" not in line:
            continue
        key, value = line.split("=", 1)
        path = key[len(prefix):].split(".", 1)
        if len(path) == 1:
            sections.setdefault(path[0], {})[".type"] = value.strip("'")
            continue
        section, option = path
        value = value.strip()
        if value.startswith("'") and value.endswith("'"):
            value = value[1:-1]
        sections.setdefault(section, {})[option] = value
    return sections


def configured_bind_ports():
    config = parse_uci_show("natter")
    if config.get("globals", {}).get("enabled") != "1":
        return set()

    ports = set()
    for options in config.values():
        if options.get(".type") != "instance" or options.get("enabled") != "1":
            continue
        try:
            port = int(options.get("bind_port", ""), 10)
        except ValueError:
            continue
        if 1 <= port <= 65535:
            ports.add(port)
    return ports


def read_port_set(path, tolerate_invalid=False):
    try:
        with open(path, "r", encoding="ascii") as port_file:
            return parse_port_set(port_file.read())
    except FileNotFoundError:
        return set()
    except ValueError:
        if tolerate_invalid:
            return set()
        raise


def write_managed_port_state(ports):
    state_dir = os.path.dirname(RESERVED_PORTS_STATE)
    if state_dir:
        os.makedirs(state_dir, exist_ok=True)
    temporary = "%s.%s" % (RESERVED_PORTS_STATE, os.getpid())
    try:
        with open(temporary, "w", encoding="ascii") as state_file:
            state_file.write(format_port_set(ports) + "\n")
        os.replace(temporary, RESERVED_PORTS_STATE)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def sync_reserved_ports(desired):
    current = read_port_set(RESERVED_PORTS_PATH)
    previously_added = read_port_set(RESERVED_PORTS_STATE, tolerate_invalid=True)

    # Preserve reservations that predate Natter.  The state file contains only
    # the ports Natter itself added, so disabling or reconfiguring Natter never
    # removes an administrator's existing reservation.
    external = current - previously_added
    newly_added = set(desired) - external
    updated = external | set(desired)
    if updated != current:
        with open(RESERVED_PORTS_PATH, "w", encoding="ascii") as port_file:
            port_file.write(format_port_set(updated) + "\n")
    write_managed_port_state(newly_added)
    return updated


def mwan3_available():
    return os.path.exists("/etc/init.d/mwan3") or os.path.exists("/usr/sbin/mwan3")


def mwan_interfaces():
    if not mwan3_available():
        return []
    try:
        result = run(["uci", "-q", "show", "mwan3"], timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return []

    names = []
    for line in result.stdout.splitlines():
        match = re.match(r"^mwan3\.([^.=]+)=interface$", line)
        if match:
            names.append(match.group(1))
    return names


def mwan3_interface_mark(interface):
    """Return the mwan3 route mark for a named IPv4 interface."""
    if not mwan3_available():
        return 0

    names = mwan_interfaces()
    try:
        # mwan3 assigns IDs in config_foreach order, including IPv6 sections.
        identifier = names.index(interface) + 1
    except ValueError:
        return 0

    try:
        mask = int(uci_get("mwan3.globals.mmx_mask", DEFAULT_MARK), 0)
    except ValueError:
        mask = int(DEFAULT_MARK, 0)
    if mask <= 0:
        return 0

    result = 0
    value_bit = 0
    for mask_bit in range(32):
        if mask & (1 << mask_bit):
            if identifier & (1 << value_bit):
                result |= 1 << mask_bit
            value_bit += 1
    return result


def configured_interfaces():
    config = parse_uci_show("natter")
    names = []
    for options in config.values():
        if options.get(".type") != "instance" or options.get("enabled") != "1":
            continue
        name = options.get("interface", "")
        if name and name not in names:
            names.append(name)
    return names


def interface_status(name):
    try:
        result = run(
            ["ubus", "call", "network.interface.%s" % name, "status"], timeout=3
        )
        data = json.loads(result.stdout) if result.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        data = {}

    addresses = data.get("ipv4-address") or []
    inside_ip = ""
    for address in addresses:
        candidate = address.get("address", "") if isinstance(address, dict) else ""
        if valid_ipv4(candidate):
            inside_ip = candidate
            break

    return {
        "interface": name,
        "device": str(data.get("l3_device") or ""),
        "inside_ip": inside_ip,
        "up": bool(data.get("up")),
    }


def distinct_interfaces():
    names = mwan_interfaces()
    if not names:
        names = configured_interfaces()
    statuses = [interface_status(name) for name in names]
    by_name = {item["interface"]: item for item in statuses}
    result = []
    seen_devices = set()

    for item in statuses:
        name = item["interface"]
        device = item["device"]
        if name.endswith("_6") and by_name.get(name[:-2]):
            continue
        if device and device in seen_devices:
            continue
        if device:
            seen_devices.add(device)
        result.append(item)
    return result


def resolve_on_wan(device, hostname, dns_server, mark):
    try:
        return resolve_host_on_device(device, hostname, dns_server, mark)
    except (OSError, UnicodeError, ValueError, socket.timeout):
        return []


def mapped_address(response, transaction_id):
    if len(response) < 20:
        raise ValueError("short STUN response")
    message_type, length, cookie = struct.unpack("!HHI", response[:8])
    if message_type != 0x0101 or cookie != 0x2112A442:
        raise ValueError("unexpected STUN response")
    if response[8:20] != transaction_id:
        raise ValueError("STUN transaction mismatch")
    if length & 0x03:
        raise ValueError("unaligned STUN response length")
    if len(response) < 20 + length:
        raise ValueError("truncated STUN response")

    offset = 20
    end = 20 + length
    while offset + 4 <= end:
        attribute_type, attribute_length = struct.unpack("!HH", response[offset:offset + 4])
        value_end = offset + 4 + attribute_length
        next_offset = offset + 4 + ((attribute_length + 3) & ~3)
        if value_end > end or next_offset > end:
            raise ValueError("truncated STUN attribute")
        value = response[offset + 4:value_end]
        if attribute_length >= 8 and len(value) >= 8 and value[1] == 0x01:
            if attribute_type == 0x0020:
                port = struct.unpack("!H", value[2:4])[0] ^ 0x2112
                raw_ip = bytes(
                    byte ^ mask
                    for byte, mask in zip(value[4:8], struct.pack("!I", 0x2112A442))
                )
                return socket.inet_ntoa(raw_ip), port
            if attribute_type == 0x0001:
                return socket.inet_ntoa(value[4:8]), struct.unpack("!H", value[2:4])[0]
        offset = next_offset
    raise ValueError("STUN response has no IPv4 mapped address")


def stun_probe(device, server, port, mark):
    transaction_id = os.urandom(12)
    request = struct.pack("!HHI", 0x0001, 0, 0x2112A442) + transaction_id
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.settimeout(2.5)
        set_wan_socket_options(sock, device, mark)
        sock.connect((server, port))
        inside_ip, inside_port = sock.getsockname()
        sock.send(request)
        public_ip, public_port = mapped_address(sock.recv(2048), transaction_id)
        return inside_ip, inside_port, public_ip, public_port
    finally:
        sock.close()


def probe_interface(status, dns_server, mark):
    result = dict(status)
    result.update({
        "public_ip": "",
        "public_port": None,
        "nat": None,
        "status": "offline",
        "error": "",
    })
    result.pop("up", None)

    if not status["up"] or not status["device"]:
        result["error"] = "interface is not up"
        return result

    errors = []
    for hostname, port in STUN_SERVERS:
        addresses = resolve_on_wan(status["device"], hostname, dns_server, mark)
        if not addresses:
            errors.append("%s did not resolve" % hostname)
            continue
        for address in addresses:
            try:
                inside_ip, _, public_ip, public_port = stun_probe(
                    status["device"], address, port, mark
                )
                if valid_ipv4(inside_ip):
                    result["inside_ip"] = inside_ip
                result.update({
                    "public_ip": public_ip,
                    "public_port": public_port,
                    "nat": result["inside_ip"] != public_ip,
                    "status": "ok",
                })
                return result
            except (OSError, ValueError, socket.timeout) as error:
                errors.append("%s:%s %s" % (address, port, error))

    result["status"] = "error"
    result["error"] = "; ".join(errors[-3:]) or "no STUN server responded"
    return result


def probe_all():
    dns_server = uci_get("natter.globals.dns_server", DEFAULT_DNS)
    results = []
    for status in distinct_interfaces():
        results.append(probe_interface(
            status, dns_server, mwan3_interface_mark(status["interface"])
        ))
    print(json.dumps(results, separators=(",", ":")))


def config_check():
    config = parse_uci_show("natter")
    global_enabled = config.get("globals", {}).get("enabled") == "1"

    configured = []
    for section, options in config.items():
        if options.get(".type") != "instance" or options.get("enabled") != "1":
            continue
        interface = options.get("interface", "")
        protocol = options.get("protocol", "tcp")
        try:
            port = int(options.get("bind_port", ""), 10)
        except ValueError:
            port = 0
        status = interface_status(interface)
        protocols = ("tcp", "udp") if protocol == "both" else (protocol,)

        for current_protocol in protocols:
            configured.append({
                "section": section,
                "interface": interface,
                "device": status["device"],
                "interface_up": status["up"],
                "protocol": current_protocol,
                "bind_port": port or None,
                "status": "ok",
                "error": "",
            })

    binding_sections = {}
    for item in configured:
        key = (item["device"], item["protocol"], item["bind_port"])
        if item["device"] and item["protocol"] in ("tcp", "udp") and item["bind_port"]:
            binding_sections.setdefault(key, []).append(item["section"])

    results = []
    for item in configured:
        current_protocol = item["protocol"]
        port = item["bind_port"] or 0
        status_up = item.pop("interface_up")
        duplicate_sections = binding_sections.get(
            (item["device"], current_protocol, item["bind_port"]), []
        )
        if not global_enabled:
            item["status"] = "disabled"
            item["error"] = "global Natter switch is disabled"
        elif current_protocol not in ("tcp", "udp"):
            item["status"] = "error"
            item["error"] = "protocol must be tcp, udp or both"
        elif not status_up or not item["device"]:
            item["status"] = "offline"
            item["error"] = "interface is not up"
        elif not 1 <= port <= 65535:
            item["status"] = "error"
            item["error"] = "inside bind port is invalid"
        elif len(duplicate_sections) > 1:
            item["status"] = "conflict"
            item["error"] = (
                "%s/%s port %s is duplicated by mappings: %s" %
                (item["device"], current_protocol.upper(), port,
                 ", ".join(duplicate_sections))
            )
        else:
            try:
                check_port_available(
                    item["device"], current_protocol, port,
                    mwan3_interface_mark(item["interface"])
                )
            except OSError as error:
                item["status"] = "conflict" if error.errno == errno.EADDRINUSE else "error"
                item["error"] = error.strerror or str(error)
        results.append(item)

    print(json.dumps(results, separators=(",", ":")))


def process_start_time(pid):
    """Return a process wall-clock start time from procfs, if available."""
    try:
        pid = int(pid)
        with open("/proc/%d/stat" % pid, "r", encoding="utf-8") as stat_file:
            stat_text = stat_file.read()
        fields = stat_text.rsplit(") ", 1)[1].split()
        start_ticks = int(fields[19], 10)
        with open("/proc/uptime", "r", encoding="utf-8") as uptime_file:
            uptime = float(uptime_file.read().split()[0])
        hz = os.sysconf("SC_CLK_TCK")
        return time.time() - uptime + start_ticks / float(hz)
    except (OSError, IndexError, ValueError, TypeError, ZeroDivisionError):
        return None


def state_belongs_to_process(state, process):
    """Reject a mapping published by an older procd worker epoch."""
    # Validation failures are emitted before procd can create a worker. Keep
    # that actionable error visible even when an older worker is still listed
    # during an in-place reload; it has no process owner by design.
    if state.get("state_owner") == "preflight":
        return True

    worker_pid = str(state.get("worker_pid") or "").strip()
    process_pid = str(process.get("pid") or "").strip()
    if worker_pid:
        return bool(process_pid) and worker_pid == process_pid

    # r17 states do not have worker_pid.  Use their timestamp as a best-effort
    # ownership check so a respawned process cannot inherit a stale successful
    # mapping.  If procfs is unavailable, preserve the legacy state instead of
    # manufacturing a false failure.
    try:
        updated_at = float(state.get("updated_at") or 0)
    except (TypeError, ValueError):
        updated_at = 0
    started_at = process_start_time(process.get("pid"))
    if not updated_at or started_at is None:
        return started_at is None
    return updated_at + 2 >= started_at


def waiting_runtime_state(instance, section, interface, protocol, bind_port,
                          inside_ip, target_ip, target_port, process):
    started_at = process_start_time(process.get("pid"))
    wait_seconds = 0
    if started_at is not None:
        wait_seconds = max(0, int(time.time() - started_at))
    stalled = wait_seconds >= STATE_PUBLISH_TIMEOUT
    return {
        "instance": instance,
        "config": section,
        "interface": interface,
        "protocol": protocol,
        "status": "stalled" if stalled else "starting",
        "error": (
            "no STUN mapping state after %ss" % wait_seconds
            if stalled else "waiting for a STUN mapping response"
        ),
        "wait_seconds": wait_seconds,
        "mapped_inside": (
            "%s:%s" % (inside_ip, bind_port)
            if inside_ip and bind_port else "-"
        ),
        "public": "-",
        "target": (
            "%s:%s" % (target_ip, target_port)
            if target_ip and target_port else "-"
        ),
        "updated_at": "",
    }


def runtime_status():
    by_instance = {}
    interface_inside_ips = {}
    for path in sorted(glob.glob("/var/run/natter/*.state")):
        item = {}
        try:
            with open(path, "r", encoding="utf-8") as state_file:
                for line in state_file:
                    key, separator, value = line.rstrip("\r\n").partition("=")
                    if separator and key:
                        item[key] = value
        except OSError as error:
            instance = os.path.basename(path).rsplit(".state", 1)[0]
            by_instance[instance] = {
                "instance": instance,
                "status": "error",
                "error": str(error),
            }
            continue
        item.setdefault("instance", os.path.basename(path).rsplit(".state", 1)[0])
        item.setdefault("status", "ok" if item.get("public") not in (None, "", "-") else "unknown")
        by_instance[item["instance"]] = item

    try:
        service_result = run(
            ["ubus", "call", "service", "list", '{"name":"natter"}'],
            timeout=3,
        )
        service_data = json.loads(service_result.stdout) if service_result.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        service_data = {}

    config = parse_uci_show("natter")
    instances = service_data.get("natter", {}).get("instances", {})
    if not isinstance(instances, dict):
        instances = {}

    for instance, process in instances.items():
        if not isinstance(process, dict):
            continue
        command = process.get("command") or []
        environment = process.get("env") or {}
        if not isinstance(command, list):
            command = []
        if not isinstance(environment, dict):
            environment = {}

        section = str(environment.get("NATTER_CONFIG_SECTION") or instance)
        interface = str(environment.get("NATTER_INTERFACE") or "")
        protocol = "udp" if "-u" in command else "tcp"
        bind_port = ""
        try:
            bind_index = command.index("-b")
            bind_port = str(command[bind_index + 1])
        except (ValueError, IndexError):
            pass

        running = bool(process.get("running"))
        current = by_instance.get(instance)
        section_config = config.get(section, {})
        if interface and interface not in interface_inside_ips:
            interface_inside_ips[interface] = interface_status(interface)["inside_ip"]
        inside_ip = interface_inside_ips.get(interface, "")
        target_ip = section_config.get("target_ip", "")
        target_port = section_config.get("target_port", "")

        if current is not None and not state_belongs_to_process(current, process):
            # A state without this worker's PID/timestamp belongs to an older
            # procd epoch.  Never present its public mapping as current.
            by_instance.pop(instance, None)
            current = None

        if current is None:
            if running:
                current = waiting_runtime_state(
                    instance, section, interface, protocol, bind_port,
                    inside_ip, target_ip, target_port, process
                )
            else:
                current = {
                    "instance": instance,
                    "config": section,
                    "interface": interface,
                    "protocol": protocol,
                    "status": "error",
                    "error": "mapping process is not running",
                    "mapped_inside": (
                        "%s:%s" % (inside_ip, bind_port)
                        if inside_ip and bind_port else "-"
                    ),
                    "public": "-",
                    "target": (
                        "%s:%s" % (target_ip, target_port)
                        if target_ip and target_port else "-"
                    ),
                    "updated_at": "",
                }
            by_instance[instance] = current
        elif not running and current.get("status") != "disabled":
            current["status"] = "error"
            current["error"] = "mapping process is not running"

    results = [by_instance[name] for name in sorted(by_instance)]
    print(json.dumps(results, separators=(",", ":")))


def resolve_command(arguments):
    if len(arguments) != 4:
        raise ValueError("usage: natter-probe resolve DEVICE HOST DNS MARK")
    device, hostname, dns_server, mark_text = arguments
    mark = int(mark_text, 0)
    if mark < 0:
        raise ValueError("invalid socket mark")
    addresses = resolve_host_on_device(device, hostname, dns_server, mark)
    for address in addresses:
        print(address)
    return 0 if addresses else 1


def check_port_command(arguments):
    if len(arguments) != 4:
        raise ValueError("usage: natter-probe check-port DEVICE PROTOCOL PORT MARK")
    device, protocol, port_text, mark_text = arguments
    port = int(port_text, 10)
    mark = int(mark_text, 0) if mark_text not in ("", "-") else 0
    if mark < 0:
        raise ValueError("invalid socket mark")
    check_port_available(device, protocol, port, mark)
    return 0


def sync_reserved_ports_command(arguments):
    if arguments:
        raise ValueError("usage: natter-probe sync-reserved-ports")
    print(format_port_set(sync_reserved_ports(configured_bind_ports())))
    return 0


def clear_reserved_ports_command(arguments):
    if arguments:
        raise ValueError("usage: natter-probe clear-reserved-ports")
    print(format_port_set(sync_reserved_ports(set())))
    return 0


if __name__ == "__main__":
    try:
        apply_proxy_bypass_group()
        if len(sys.argv) > 1 and sys.argv[1] == "resolve":
            sys.exit(resolve_command(sys.argv[2:]))
        if len(sys.argv) > 1 and sys.argv[1] == "check-port":
            sys.exit(check_port_command(sys.argv[2:]))
        if len(sys.argv) > 1 and sys.argv[1] == "sync-reserved-ports":
            sys.exit(sync_reserved_ports_command(sys.argv[2:]))
        if len(sys.argv) > 1 and sys.argv[1] == "clear-reserved-ports":
            sys.exit(clear_reserved_ports_command(sys.argv[2:]))
        if len(sys.argv) > 1 and sys.argv[1] == "config-check":
            if len(sys.argv) != 2:
                raise ValueError("usage: natter-probe config-check")
            config_check()
            sys.exit(0)
        if len(sys.argv) > 1 and sys.argv[1] == "runtime-status":
            if len(sys.argv) != 2:
                raise ValueError("usage: natter-probe runtime-status")
            runtime_status()
            sys.exit(0)
        if len(sys.argv) > 1:
            raise ValueError(
                "usage: natter-probe [config-check|runtime-status|"
                "check-port DEVICE PROTOCOL PORT MARK|sync-reserved-ports|"
                "clear-reserved-ports|"
                "resolve DEVICE HOST DNS MARK]"
            )
        probe_all()
    except (OSError, UnicodeError, ValueError, socket.timeout) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
