#!/bin/sh

show_status() {
	if /etc/init.d/natter running; then
		echo "natter service: running"
	else
		echo "natter service: stopped"
	fi

	found=0
	for state in /var/run/natter/*.state; do
		[ -f "$state" ] || continue
		found=1
		echo
		cat "$state"
	done
	[ "$found" -eq 1 ] || echo "no active public mappings reported"
}

show_service_status() {
	global_enabled=0
	init_enabled=0
	procd_running=0
	state=''
	reason=''

	[ "$(uci -q get natter.globals.enabled 2>/dev/null)" = 1 ] && \
		global_enabled=1
	/etc/init.d/natter enabled >/dev/null 2>&1 && init_enabled=1
	/etc/init.d/natter running >/dev/null 2>&1 && procd_running=1

	if [ "$procd_running" -eq 1 ]; then
		if [ "$global_enabled" -eq 0 ]; then
			state=running-disabled
			reason='procd is still running while the global Natter switch is disabled'
		elif [ "$init_enabled" -eq 1 ]; then
			state=running
			reason='procd has at least one running instance'
		else
			state=running-manual
			reason='procd is running but init service is not enabled at boot'
		fi
	elif [ "$global_enabled" -eq 0 ]; then
		state=disabled
		reason='global Natter switch is disabled'
	elif [ "$init_enabled" -eq 0 ]; then
		state=not-autostarted
		reason='init service is not enabled at boot'
	else
		state=stopped
		reason='no running procd instances; start may have failed'
	fi

	printf '{"state":"%s","reason":"%s","global_enabled":%s,"init_enabled":%s,"procd_running":%s}\n' \
		"$state" "$reason" "$global_enabled" "$init_enabled" "$procd_running"
}

case "${1:-status}" in
	status|mappings) show_status ;;
	service-status) show_service_status ;;
	firewall)
		for chain in dstnat forward input; do
			echo "[$chain]"
			cat "/usr/share/natter/runtime/$chain.nft"
		done
	;;
	restart) /etc/init.d/natter restart ;;
	probe-all) exec /usr/libexec/natter-probe ;;
	check-config) exec /usr/libexec/natter-probe config-check ;;
	status-json) exec /usr/libexec/natter-probe runtime-status ;;
	*) echo "usage: natterctl {status|service-status|status-json|mappings|firewall|probe-all|check-config|restart}" >&2; exit 2 ;;
esac
