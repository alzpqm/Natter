         GREY = YELLOW_BOLD = RED_BOLD = RESET = ""
 
     @staticmethod
+    def _stream(level):
+        # procd maps stdout to daemon.info and stderr to daemon.err. Keep
+        # warnings and informational diagnostics out of the error stream on
+        # OpenWrt while preserving real errors at daemon.err.
+        if os.environ.get("NATTER_OPENWRT_LOG") == "1" and level < Logger.ERROR:
+            return sys.stdout
+        return sys.stderr
+
+    @staticmethod
     def set_level(level):
         Logger.level = level
 
