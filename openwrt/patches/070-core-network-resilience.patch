+    @staticmethod
+    def _read_exact(sock, size, deadline):
+        chunks = []
+        while size:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise socket.timeout("STUN response deadline exceeded")
+            sock.settimeout(remaining)
+            chunk = sock.recv(size)
+            if not chunk:
+                raise ValueError("Truncated STUN response")
+            chunks.append(chunk)
+            size -= len(chunk)
+        return b"".join(chunks)
 
+    @staticmethod
+    def _response_length(header, transaction_id):
+        if len(header) < 20:
+            raise ValueError("Truncated STUN header")
+        msg_type, length, cookie = struct.unpack("!HHI", header[:8])
+        if (msg_type != 0x0101 or cookie != 0x2112a442 or
+                header[8:20] != transaction_id or length % 4):
+            raise ValueError("Invalid STUN response header or transaction")
+        return length
+
+    @staticmethod
+    def _mapped_address(buff, transaction_id):
+        length = StunClient._response_length(buff, transaction_id)
+        if len(buff) != 20 + length:
+            raise ValueError("Invalid STUN response length")
+        mappings = {}
+        offset = 20
+        while offset < len(buff):
+            attr_type, attr_len = struct.unpack("!HH", buff[offset:offset + 4])
+            value_start = offset + 4
+            next_offset = value_start + ((attr_len + 3) & ~3)
+            if next_offset > len(buff):
+                raise ValueError("Truncated STUN attribute")
+            if attr_type in (1, 32):
+                if attr_len != 8 or buff[value_start + 1] != 1:
+                    raise ValueError("Invalid STUN IPv4 mapped address")
+                _, _, port, ip = struct.unpack("!BBHI", buff[value_start:value_start + 8])
+                if attr_type == 32:
+                    port ^= 0x2112
+                    ip ^= 0x2112a442
+                if not port:
+                    raise ValueError("Invalid STUN mapped port")
+                if attr_type not in mappings:
+                    mappings[attr_type] = (socket.inet_ntop(socket.AF_INET,
+                                          struct.pack("!I", ip)), port)
+            offset = next_offset
+        # Prefer XOR over legacy MAPPED-ADDRESS even if it occurs later.
+        if not mappings:
+            raise ValueError("STUN response has no IPv4 mapped address")
+        return mappings.get(32, mappings.get(1))
